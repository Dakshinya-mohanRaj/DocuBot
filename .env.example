# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.

# Required: Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: chat model. Validated against your account's live model list on first
# chat request. Defaults to openai/gpt-oss-20b (fast + cheap).
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: local sentence-transformers embedding model. Changing it requires
# deleting the Chroma store (data/chroma) and re-ingesting every document.
# DOCUBOT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: retrieval tuning
# DOCUBOT_MIN_RELEVANCE=0.30
# DOCUBOT_LEXICAL_WEIGHT=0.5
# DOCUBOT_PER_DOC_CAP=2

# Optional: max chunks document analysis may read at once (bounds prompt tokens)
# DOCUBOT_ANALYSIS_MAX_CHUNKS=40

# Optional: storage paths
# DOCUBOT_CHROMA_PATH=./data/chroma
# DOCUBOT_COLLECTION=docubot_chunks_v2

# Optional: comma-separated CORS origins. Empty = same-origin only (default).
# DOCUBOT_CORS_ORIGINS=

# Optional: per-IP rate limits (requests per minute). 0 disables a limiter.
# DOCUBOT_RATE_LIMIT_CHAT=20
# DOCUBOT_RATE_LIMIT_INGEST=10
# DOCUBOT_RATE_LIMIT_AUTH=10

# ---------------------------------------------------------------------------
# Accounts & multi-tenancy (DocuBot 4.0)
# ---------------------------------------------------------------------------
# Relational database for users, auth sessions, and conversations.
# Production: set this to your Neon (or other managed Postgres) connection
# string — Neon gives you `postgresql://...?sslmode=require`, which the app
# maps to the psycopg3 driver automatically. Unset falls back to a local
# SQLite file at ./data/docubot.db for development and the test suite.
#   e.g. postgresql://user:pass@ep-xxx.aws.neon.tech/docubot?sslmode=require
# DOCUBOT_DATABASE_URL=sqlite:///./data/docubot.db

# Session lifetime in days (cookie + server-side record).
# DOCUBOT_SESSION_TTL_DAYS=14

# Mark session/CSRF cookies Secure. "true" (default) is correct behind HTTPS
# (Render); set to "false" only for local http development or the test suite.
# DOCUBOT_COOKIE_SECURE=true

# Minimum password length for signup.
# DOCUBOT_MIN_PASSWORD_LENGTH=8

# Max stored messages per conversation before the oldest are trimmed.
# DOCUBOT_MAX_STORED_MESSAGES=200
